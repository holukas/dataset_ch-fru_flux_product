e; InfluxDB stores variable names as '_field'\nDATA_VERSION = ['meteoscreening_diive']\n\nSTART = '2023-01-01 00:00:01'  # Download data starting with this date\nSTOP = '2026-01-01 00:00:01'  # Download data before this date (the stop date itself is not included)\nTIMEZONE_OFFSET_TO_UTC_HOURS = 1  # Timezone, e.g. \"1\" is translated to timezone \"UTC+01:00\" (CET, winter time)\n\n# Data download\ndata_simple, data_detailed, assigned_measurements = \\\n    dbc.download(\n        bucket=BUCKET,\n        measurements=MEASUREMENTS,\n        fields=FIELDS,\n        start=START,\n        stop=STOP,\n        timezone_offset_to_utc_hours=TIMEZONE_OFFSET_TO_UTC_HOURS,\n        data_version=DATA_VERSION\n)","key":"UOTV9qL0vS"},{"type":"outputs","id":"wsfjbBXWrF939eZwRETK6","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"\nDOWNLOADING\n    from bucket ch-fru_processed\n    variables ['RH_T1_2_1', 'TA_T1_2_1', 'SW_IN_T1_1_1']\n    from measurements ['RH', 'TA', 'SW']\n    from data version ['meteoscreening_diive']\n    between 2023-01-01 00:00:01 and 2026-01-01 00:00:01\n    with timezone offset to UTC of 1\nUsing querystring:\nfrom(bucket: \"ch-fru_processed\") |> range(start: 2023-01-01T00:00:01+01:00, stop: 2026-01-01T00:00:01+01:00) |> filter(fn: (r) => r[\"_measurement\"] == \"RH\" or r[\"_measurement\"] == \"TA\" or r[\"_measurement\"] == \"SW\") |> filter(fn: (r) => r[\"data_version\"] == \"meteoscreening_diive\") |> filter(fn: (r) => r[\"_field\"] == \"RH_T1_2_1\" or r[\"_field\"] == \"TA_T1_2_1\" or r[\"_field\"] == \"SW_IN_T1_1_1\") |> pivot(rowKey:[\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\nUsed querystring: from(bucket: \"ch-fru_processed\") |> range(start: 2023-01-01T00:00:01+01:00, stop: 2026-01-01T00:00:01+01:00) |> filter(fn: (r) => r[\"_measurement\"] == \"RH\" or r[\"_measurement\"] == \"TA\" or r[\"_measurement\"] == \"SW\") |> filter(fn: (r) => r[\"data_version\"] == \"meteoscreening_diive\") |> filter(fn: (r) => r[\"_field\"] == \"RH_T1_2_1\" or r[\"_field\"] == \"TA_T1_2_1\" or r[\"_field\"] == \"SW_IN_T1_1_1\") |> pivot(rowKey:[\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\nquerystring was constructed from:\n    bucketstring: from(bucket: \"ch-fru_processed\")\n    rangestring: |> range(start: 2023-01-01T00:00:01+01:00, stop: 2026-01-01T00:00:01+01:00)\n    measurementstring: |> filter(fn: (r) => r[\"_measurement\"] == \"RH\" or r[\"_measurement\"] == \"TA\" or r[\"_measurement\"] == \"SW\")\n    dataversionstring: |> filter(fn: (r) => r[\"data_version\"] == \"meteoscreening_diive\")\n    fieldstring: |> filter(fn: (r) => r[\"_field\"] == \"RH_T1_2_1\" or r[\"_field\"] == \"TA_T1_2_1\" or r[\"_field\"] == \"SW_IN_T1_1_1\")\n    pivotstring: |> pivot(rowKey:[\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\nDownload finished.\nDownloaded data for 3 variables:\n<-- RH_T1_2_1  (51303 records)  first date: 2023-01-01 00:30:00  last date: 2026-01-01 00:00:00\n<-- SW_IN_T1_1_1  (52106 records)  first date: 2023-01-01 00:30:00  last date: 2026-01-01 00:00:00\n<-- TA_T1_2_1  (51303 records)  first date: 2023-01-01 00:30:00  last date: 2026-01-01 00:00:00\n========================================\nFields in measurement RH of bucket ch-fru_processed:\n#1  ch-fru_processed  RH  RH\n#2  ch-fru_processed  RH  RH_EP\n#3  ch-fru_processed  RH  RH_T1_2_1\nFound 3 fields in measurement RH of bucket ch-fru_processed.\n========================================\n========================================\nFields in measurement TA of bucket ch-fru_processed:\n#1  ch-fru_processed  TA  TA_EP\n#2  ch-fru_processed  TA  TA_ERA\n#3  ch-fru_processed  TA  TA_F\n#4  ch-fru_processed  TA  TA_F_MDS\n#5  ch-fru_processed  TA  TA_F_MDS_QC\n#6  ch-fru_processed  TA  TA_F_QC\n#7  ch-fru_processed  TA  TA_T1_2_1\n#8  ch-fru_processed  TA  T_SONIC\nFound 8 fields in measurement TA of bucket ch-fru_processed.\n========================================\n========================================\nFields in measurement SW of bucket ch-fru_processed:\n#1  ch-fru_processed  SW  NIGHT\n#2  ch-fru_processed  SW  SW_IN_CORRECTED_T1_2_1\n#3  ch-fru_processed  SW  SW_IN_ERA\n#4  ch-fru_processed  SW  SW_IN_F\n#5  ch-fru_processed  SW  SW_IN_F_MDS\n#6  ch-fru_processed  SW  SW_IN_F_MDS_QC\n#7  ch-fru_processed  SW  SW_IN_F_QC\n#8  ch-fru_processed  SW  SW_IN_POT\n#9  ch-fru_processed  SW  SW_IN_T1_1_1\n#10  ch-fru_processed  SW  SW_IN_T1_2_1\n#11  ch-fru_processed  SW  SW_OUT\n#12  ch-fru_processed  SW  SW_OUT_T1_1_1\n#13  ch-fru_processed  SW  SW_OUT_T1_2_1\nFound 13 fields in measurement SW of bucket ch-fru_processed.\n========================================\n"},"children":[],"key":"RUvYEHQfKz"}],"key":"UdH3IoRx8b"}],"key":"xSDIFjecrZ"},{"type":"block","kind":"notebook-content","children":[],"key":"Ub15bWxDOo"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":1,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot downloaded data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Ki7gzplkhG"}],"key":"oAXsFAVMsx"}],"identifier":"plot-downloaded-data","label":"Plot downloaded data","html_id":"plot-downloaded-data","implicit":true,"key":"kQM56MBX4V"}],"key":"vzLM6YYwtB"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"data_simple.plot(x_compat=True, figsize=(16, 6), title=\"Downloaded data\", subplots=True);","key":"QQpfDk1bLH"},{"type":"outputs","id":"W7_wEaHFM-dBoNnTvlGli","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"e91b9d0180b3b188272289ea1e5db8f5","path":"/build/e91b9d0180b3b188272289ea1e5db8f5.png"},"text/plain":{"content":"<Figure size 1600x600 with 3 Axes>",